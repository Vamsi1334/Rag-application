{
  "name": "ai-document-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "RAG-based AI Document Assistant. Ask questions about your own documents and get answers with source citations.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "dev:pretty": "next dev | pino-pretty"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "mongodb": "6.21.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
