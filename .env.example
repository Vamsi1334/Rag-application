########################################################################
# AI Document Assistant - environment template
#
# Copy this file to .env.local and fill in what you have:
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# .env.local is gitignored and is the ONLY place real values belong.
# Never put a secret in source code, and never commit a filled-in file.
#
# Nothing below is required to run phase 1. Variables for features that do
# not exist yet are optional; each is marked with the phase that needs it.
########################################################################

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Server-side URL of this app.
APP_URL=http://localhost:3000

# Same value, but readable in the browser. Anything prefixed NEXT_PUBLIC_ is
# compiled into the JavaScript bundle and is visible to anyone. Never put a
# secret behind this prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------------------
# Database
#
# Required for documents and conversations. The app starts without it and
# reports the database as "not set" on the home page and /api/health.
# ---------------------------------------------------------------------
# MongoDB Atlas connection string. CONTAINS A PASSWORD: treat it as a secret,
# never commit it, never paste it into a chat or an issue.
#
# Get it from Atlas: Database > Connect > Drivers > Node.js. It looks like
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If your password contains @ : / ? # [ ] or %, percent-encode it, or the
# driver misreads where the password ends. Atlas can generate a safe one.
MONGODB_URI=

# Which database inside the cluster to use. Give each environment its own:
# a preview deployment sharing the production database will write test rows
# into real user data.
MONGODB_DB_NAME=ai_document_assistant


# ---------------------------------------------------------------------
# Authentication
#
# Required to sign in. The app starts without these and reports
# authentication as "not set" on the home page and /api/health.
# ---------------------------------------------------------------------
# Signs and encrypts the session cookie. SECRET. Minimum 32 characters.
# Generate a fresh one and paste it in:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it invalidates every existing session, which is also how you force
# everyone to sign in again if you ever need to.
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application).
#
# Authorized redirect URI for local development, exactly this:
#   http://localhost:3000/api/auth/callback/google
#
# GOOGLE_CLIENT_SECRET is a SECRET. It is used only in a server-to-server call
# to exchange an authorization code for tokens, and never reaches the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------
# Text generation
#
# LLM_PROVIDER selects which vendor the app talks to. The application code
# never names a provider, so changing this line is the whole switch.
# Options: ollama | groq | openrouter | openai | google
# ---------------------------------------------------------------------
# For production use a hosted provider: Ollama runs on YOUR machine, so a
# deployed app cannot reach it. Options: ollama | groq | openrouter | openai
LLM_PROVIDER=groq

# Model override, applied whichever provider is selected. Usually left unset.
#
# Model names are not portable: "llama3.2:1b" means nothing to Groq. So each
# provider has its own variable (OLLAMA_MODEL below) and the app falls back to
# a sensible default per provider. That is what lets you change LLM_PROVIDER on
# its own without also remembering to change the model name to match.
#
# Resolution order: LLM_MODEL, then <PROVIDER>_MODEL, then the built-in default.
# LLM_MODEL=

# LLM_BASE_URL=            # overrides the provider's default endpoint
# LLM_API_KEY=             # required for every provider except ollama

# 0 is the most predictable, 2 the most random. Answers grounded in retrieved
# text want a low value.
LLM_TEMPERATURE=0.2

# Ceiling on the length of a generated answer.
#
# Current hosted models think before they answer, and those thinking tokens
# count against this same number. Too low and the model spends the whole budget
# reasoning, then gets cut off mid-sentence.
LLM_MAX_OUTPUT_TOKENS=2048

# Total token budget for one request: instructions, chat history, retrieved
# passages, question and answer all share this number.
LLM_CONTEXT_WINDOW=8192

# How long to wait for a response, in milliseconds. Two minutes sounds
# excessive until you run a model on a CPU: the first request after an idle
# period also pays to load several gigabytes of weights into memory before
# generating a single token. Measured on this project: 13s cold, 0.5s warm.
LLM_TIMEOUT_MS=120000


# ---------------------------------------------------------------------
# Embeddings
#
# Configured separately from generation on purpose. Embeddings are cheap
# enough to run locally forever; generation usually is not.
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Vector length produced by the model above. This value gets baked into the
# database index, so changing it later means re-embedding every document.
EMBEDDING_DIMENSIONS=768

# nomic-embed-text was trained with task prefixes and quietly produces worse
# vectors without them. Nothing errors if they are wrong; search just gets
# slightly bad, which is the hardest kind of bug to notice.
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "


# ---------------------------------------------------------------------
# Hosted provider credentials  (SECRET)
#
# Each provider has its own key, so several can be configured at once and
# switching LLM_PROVIDER above stays a genuine one-line change.
# ---------------------------------------------------------------------
# Groq: the default provider. Free tier, no credit card required.
# Get a key at https://console.groq.com  (Settings > API Keys)
#
# The key looks like gsk_... and is a SECRET. It is read only by server-side
# code, never reaches the browser, and must never be committed.
#
# The free tier is rate limited per minute AND per day, and the numbers change.
# As of September 2026: 30 requests/min, 1,000/day, 8,000 tokens/min, 200,000
# tokens/day. Your account's current limits are on the Limits page in the
# console; that page is the source of truth, not this comment.
#
# Model names go stale too. Groq shut down llama-3.3-70b-versatile on
# 2026-08-16, so if you see a 404 naming a model, check the Deprecations page.
# openai/gpt-oss-20b is the smaller, faster sibling if you want more headroom.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: one key, many models. 20 req/min, 50 req/day on the free tier.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI: paid after the initial trial credit.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini. NOT the same thing as GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above,
# which are for signing in with Google. Different service, different key.
# Not implemented yet; arrives with embeddings.
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash


# ---------------------------------------------------------------------
# Ollama  (local, optional)
#
# Still supported and still useful: free, offline, and your documents never
# leave the machine. Set LLM_PROVIDER=ollama to use it.
# ---------------------------------------------------------------------
# 127.0.0.1 rather than localhost: on some Windows setups localhost resolves
# to IPv6 first and the connection is refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which model Ollama should run. It must already be pulled:
#   ollama pull llama3.2:1b
# See what you have with: ollama list
OLLAMA_MODEL=llama3.2:1b


# ---------------------------------------------------------------------
# Removed
# ---------------------------------------------------------------------
# ENABLE_AI_TEST_ENDPOINT used to be here. It kept /api/ai/chat switched off in
# production because that route had no authentication. The route now requires a
# signed-in user, so the flag is gone. If it is still in your .env.local you can
# delete the line; it is ignored either way.
