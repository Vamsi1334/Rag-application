########################################################################
# AI Document Assistant - environment template
#
# Copy this file to .env.local and fill in what you have:
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# .env.local is gitignored and is the ONLY place real values belong.
# Never put a secret in source code, and never commit a filled-in file.
#
# Nothing below is required to run phase 1. Variables for features that do
# not exist yet are optional; each is marked with the phase that needs it.
########################################################################

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Server-side URL of this app.
APP_URL=http://localhost:3000

# Same value, but readable in the browser. Anything prefixed NEXT_PUBLIC_ is
# compiled into the JavaScript bundle and is visible to anyone. Never put a
# secret behind this prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------------------
# Database
#
# Required for documents and conversations. The app starts without it and
# reports the database as "not set" on the home page and /api/health.
# ---------------------------------------------------------------------
# MongoDB Atlas connection string. CONTAINS A PASSWORD: treat it as a secret,
# never commit it, never paste it into a chat or an issue.
#
# Get it from Atlas: Database > Connect > Drivers > Node.js. It looks like
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# If your password contains @ : / ? # [ ] or %, percent-encode it, or the
# driver misreads where the password ends. Atlas can generate a safe one.
MONGODB_URI=

# Which database inside the cluster to use. Give each environment its own:
# a preview deployment sharing the production database will write test rows
# into real user data.
MONGODB_DB_NAME=ai_document_assistant


# ---------------------------------------------------------------------
# Authentication
#
# Required to sign in. The app starts without these and reports
# authentication as "not set" on the home page and /api/health.
# ---------------------------------------------------------------------
# Signs and encrypts the session cookie. SECRET. Minimum 32 characters.
# Generate a fresh one and paste it in:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it invalidates every existing session, which is also how you force
# everyone to sign in again if you ever need to.
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application).
#
# Authorized redirect URI for local development, exactly this:
#   http://localhost:3000/api/auth/callback/google
#
# GOOGLE_CLIENT_SECRET is a SECRET. It is used only in a server-to-server call
# to exchange an authorization code for tokens, and never reaches the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------
# Text generation
#
# LLM_PROVIDER selects which vendor the app talks to. The application code
# never names a provider, so changing this line is the whole switch.
# Options: ollama | groq | openrouter | openai | google
# ---------------------------------------------------------------------
# For production use a hosted provider: Ollama runs on YOUR machine, so a
# deployed app cannot reach it. Options: ollama | groq | openrouter | openai
LLM_PROVIDER=groq

# Model override, applied whichever provider is selected. Usually left unset.
#
# Model names are not portable: "llama3.2:1b" means nothing to Groq. So each
# provider has its own variable (OLLAMA_MODEL below) and the app falls back to
# a sensible default per provider. That is what lets you change LLM_PROVIDER on
# its own without also remembering to change the model name to match.
#
# Resolution order: LLM_MODEL, then <PROVIDER>_MODEL, then the built-in default.
# LLM_MODEL=

# LLM_BASE_URL=            # overrides the provider's default endpoint
# LLM_API_KEY=             # required for every provider except ollama

# 0 is the most predictable, 2 the most random. Answers grounded in retrieved
# text want a low value.
LLM_TEMPERATURE=0.2

# Ceiling on the length of a generated answer.
#
# Current hosted models think before they answer, and those thinking tokens
# count against this same number. Too low and the model spends the whole budget
# reasoning, then gets cut off mid-sentence.
LLM_MAX_OUTPUT_TOKENS=2048

# Total token budget for one request: instructions, chat history, retrieved
# passages, question and answer all share this number.
LLM_CONTEXT_WINDOW=8192

# How long to wait for a response, in milliseconds. Two minutes sounds
# excessive until you run a model on a CPU: the first request after an idle
# period also pays to load several gigabytes of weights into memory before
# generating a single token. Measured on this project: 13s cold, 0.5s warm.
LLM_TIMEOUT_MS=120000


# ---------------------------------------------------------------------
# Embeddings
#
# A SEPARATE VENDOR from generation, and not by accident.
#
# Groq writes answers and publishes no embedding model. Voyage produces
# embeddings and publishes no chat model. They are different kinds of model
# doing different jobs, so they get their own settings.
#
#   your question  ->  Voyage   ->  numbers  ->  search finds passages
#   passages       ->  Groq     ->  the answer
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=voyage

# Generic model override, applied whichever provider is selected. Usually left
# unset in favour of VOYAGE_EMBEDDING_MODEL below, exactly as LLM_MODEL relates
# to GROQ_MODEL.
# EMBEDDING_MODEL=

# EMBEDDING_BASE_URL=      # overrides the provider's default endpoint
# EMBEDDING_API_KEY=       # generic override; prefer VOYAGE_API_KEY below

# Vector length, and the least reversible setting in this file.
#
# It is declared on the Atlas vector index and every stored vector must match
# it. Changing it means a new index plus re-embedding every document you have
# ever uploaded, because a 256-number question cannot be compared against
# 1024-number passages. Different spaces, not different scales.
#
# 256 rather than Voyage's 1024 default. Their v4 models pack the most
# important information into the earliest numbers, so truncating costs less
# accuracy than you would expect. The reason to take that trade is storage: at
# 4 bytes per number, 1024 dims is 4KB per chunk, and an Atlas M0 cluster has
# 512MB for vectors, text and indexes combined. 256 dims is 1KB.
#
# Voyage v4 accepts 256, 512, 1024 or 2048. Nothing else.
EMBEDDING_DIMENSIONS=256

# Task prefixes, for models that need the hint written into the text itself.
# Ollama's nomic-embed-text does. Voyage does the same job with an input_type
# field and prepends its own wording server-side, so the Voyage provider
# ignores these. Prepending them too would give the model two competing hints.
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "


# ---------------------------------------------------------------------
# Embedding rate limits
#
# THE DEFAULTS BELOW ARE SIZED FOR VOYAGE'S FREE TRIAL, which allows
# 3 requests and 10,000 tokens per minute until you add a payment method.
#
# That ceiling is low enough to change the shape of the problem rather than
# just the numbers. 10,000 tokens a minute is about 22 passages, so a
# sixty-page PDF cannot be embedded in one request at any batch size, and
# retrying does not help: the request itself is over the limit. Requests have
# to be both smaller and spaced out, which is what these three do.
#
# The cost is time. A sixty-page document takes two to three minutes, and the
# script prints how long it expects to wait before it starts.
# ---------------------------------------------------------------------
# Estimated tokens allowed in one request. Kept below the per-minute ceiling
# because the estimate is characters divided by four, and it reads low for
# tables, code and non-Latin scripts. The gap is headroom, not waste.
EMBEDDING_MAX_TOKENS_PER_REQUEST=8000

# The two numbers from the vendor's own limits page. The provider waits the
# longer of the two gaps they imply, so pacing stays correct whatever the batch
# size is, and the batch size stays a performance choice rather than a
# correctness-critical one.
#
# Pacing on requests alone is not enough, and the failure is not subtle: three
# requests a minute at 8,000 tokens each honours the request rate perfectly and
# breaches a 10,000-token minute more than twice over.
EMBEDDING_REQUESTS_PER_MINUTE=3
EMBEDDING_TOKENS_PER_MINUTE=10000

# Retries for a rate-limited request. On a free tier a 429 is an ordinary
# event, so this is the normal path rather than error handling. Retry-After is
# honoured when the server sends it.
EMBEDDING_MAX_RETRIES=4

# AFTER ADDING A PAYMENT METHOD, Voyage tier 1 for voyage-4-lite is
# 2,000 requests and 16,000,000 tokens per minute. Raise these two and
# ingestion stops waiting at all:
#
#   EMBEDDING_REQUESTS_PER_MINUTE=2000
#   EMBEDDING_TOKENS_PER_MINUTE=16000000


# ---------------------------------------------------------------------
# Chunking
#
# A document cannot be embedded whole: one vector for fifty pages is the
# average of everything, which is close to nothing in particular. It is cut
# into passages, and the passage is what gets embedded, retrieved and cited.
# ---------------------------------------------------------------------
# Characters, not tokens, because chunking happens before any tokenizer is
# involved. 1800 characters is roughly 450 tokens.
#
# The sum that produced it: retrieval fetches about five passages, and those
# five plus the question, the instructions and room for an answer all have to
# fit inside the model's 8192 token context. Five 450-token passages is ~2250
# tokens, which leaves comfortable headroom.
#
# Smaller chunks match a question more sharply but arrive without the context
# that explains them. Larger chunks carry context but dilute the match. There
# is no correct answer, only one that suits your corpus.
CHUNK_SIZE=1800

# How much text each chunk repeats from the one before it. Without overlap, a
# sentence straddling a boundary is cut in half and neither half retrieves
# well. 200 characters is about 11 percent: enough to carry a sentence across
# the join without storing the document twice.
CHUNK_OVERLAP=200


# ---------------------------------------------------------------------
# Retrieval
#
# How a question finds the passages that might answer it.
# ---------------------------------------------------------------------
# How many passages one question retrieves.
#
# Too few and the answer misses something the document actually says, because
# the passage covering it ranked sixth. Too many and the useful passage is
# diluted among weak ones, the model has more room to wander, and every
# question costs more of the context window.
#
# Five passages at ~450 tokens is about 2,250 tokens, comfortable inside an
# 8,192 token context alongside the instructions, the question and the answer.
RETRIEVAL_TOP_K=5

# The share of the context window that retrieved passages may occupy.
#
# A ceiling, not a target. Passages are added in rank order until it is
# reached, so a run of unusually long ones drops the weakest rather than
# crowding out the space the answer needs. Without it, five long passages plus
# a long question leaves the model no room to reply, and the symptom is a
# truncated answer rather than an error.
RETRIEVAL_CONTEXT_SHARE=0.5


# ---------------------------------------------------------------------
# Hosted provider credentials  (SECRET)
#
# Each provider has its own key, so several can be configured at once and
# switching LLM_PROVIDER above stays a genuine one-line change.
# ---------------------------------------------------------------------
# Groq: the default provider. Free tier, no credit card required.
# Get a key at https://console.groq.com  (Settings > API Keys)
#
# The key looks like gsk_... and is a SECRET. It is read only by server-side
# code, never reaches the browser, and must never be committed.
#
# The free tier is rate limited per minute AND per day, and the numbers change.
# As of September 2026: 30 requests/min, 1,000/day, 8,000 tokens/min, 200,000
# tokens/day. Your account's current limits are on the Limits page in the
# console; that page is the source of truth, not this comment.
#
# Model names go stale too. Groq shut down llama-3.3-70b-versatile on
# 2026-08-16, so if you see a 404 naming a model, check the Deprecations page.
# openai/gpt-oss-20b is the smaller, faster sibling if you want more headroom.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: one key, many models. 20 req/min, 50 req/day on the free tier.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI: paid after the initial trial credit.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini. NOT the same thing as GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above,
# which are for signing in with Google. Different service, different key.
# Not implemented.
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash

# Voyage, for EMBEDDINGS. SECRET.
# Get a key at https://console.voyageai.com  (API Keys)
#
# A different company from Groq, doing a different job, so a different key.
# Sending one to the other is a 401 that reads like a bad key rather than
# crossed wiring, which is why the code never falls back between them.
#
# Named VOYAGE_EMBEDDING_MODEL rather than VOYAGE_MODEL because Voyage only
# makes embedding models. The longer name says which half of the stack it
# belongs to, next to GROQ_MODEL which is the other half.
#
# voyage-4-lite is the default: the cheapest of the current generation, 32k
# input, and it supports reducing output dimensions to 256. voyage-4 and
# voyage-4-large are better and more expensive. The older voyage-3 family gets
# no free tokens at all, which is an easy trap.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite


# ---------------------------------------------------------------------
# Ollama  (local, optional)
#
# Still supported and still useful: free, offline, and your documents never
# leave the machine. Set LLM_PROVIDER=ollama to use it.
# ---------------------------------------------------------------------
# 127.0.0.1 rather than localhost: on some Windows setups localhost resolves
# to IPv6 first and the connection is refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which model Ollama should run. It must already be pulled:
#   ollama pull llama3.2:1b
# See what you have with: ollama list
OLLAMA_MODEL=llama3.2:1b


# ---------------------------------------------------------------------
# Removed
# ---------------------------------------------------------------------
# ENABLE_AI_TEST_ENDPOINT used to be here. It kept /api/ai/chat switched off in
# production because that route had no authentication. The route now requires a
# signed-in user, so the flag is gone. If it is still in your .env.local you can
# delete the line; it is ignored either way.
